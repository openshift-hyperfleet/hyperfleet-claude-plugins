extends: default

rules:
  document-start: disable
  line-length: disable
  comments:
    min-spaces-from-content: 1
  indentation:
    spaces: consistent
    indent-sequences: whatever
  truthy: disable
  trailing-spaces: disable
  empty-lines: disable
  new-line-at-end-of-file: disable
  comments-indentation: disable
  braces:
    max-spaces-inside: -1
